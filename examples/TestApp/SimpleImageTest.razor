@namespace TestApp
@using Sandbox.UI
@inherits Panel

<root style="width: 800px; height: 600px; padding: 20px; flex-direction: column; background-color: #f5f5f5;">
    <div style="font-size: 24px; font-weight: bold; margin-bottom: 20px;">Image Rendering Test</div>
    
    <div style="flex-direction: row; gap: 20px;">
        <div style="flex-direction: column; align-items: center; background-color: white; padding: 15px; border-radius: 8px;">
            <div style="font-size: 14px; margin-bottom: 10px;">Valid image (if exists)</div>
            <img src="Assets/images/test-image.png" style="width: 150px; height: 150px;" />
        </div>
        
        <div style="flex-direction: column; align-items: center; background-color: white; padding: 15px; border-radius: 8px;">
            <div style="font-size: 14px; margin-bottom: 10px;">Missing texture fallback</div>
            <img src="nonexistent.png" style="width: 150px; height: 150px;" />
        </div>
        
        <div style="flex-direction: column; align-items: center; background-color: white; padding: 15px; border-radius: 8px;">
            <div style="font-size: 14px; margin-bottom: 10px;">Object-fit: cover</div>
            <img src="Assets/images/test-image.png" style="width: 150px; height: 150px; object-fit: cover;" />
        </div>
    </div>
    
    <button onclick=@Close style="margin-top: 20px; width: 100px;">Close</button>
</root>

@code {
    void Close()
    {
        Delete();
    }
}
