@namespace TestApp
@using Sandbox.UI
@using Fazor.Controls
@inherits Window

<root title="@bind-value Test" hasminimise="true" hasmaximise="true" hasclose="true" windowwidth="600" windowheight="400">
    <div class="window-content" style="padding: 20px; flex-direction: column; gap: 15px;">
        <div style="font-size: 20px; font-weight: bold;">Testing @bind-value</div>
        
        <div style="flex-direction: column; gap: 10px;">
            <div style="font-weight: bold;">Test with @bind-value:</div>
            <textentry @bind-value="testValue" placeholder="Type here..." style="padding: 5px; background-color: white; border: 1px solid #ccc;"></textentry>
            <div style="font-size: 12px;">Bound value: @testValue</div>
        </div>

        <div style="flex-direction: column; gap: 10px;">
            <div style="font-weight: bold;">Manual binding (for comparison):</div>
            <textentry value="@manualValue" @ref="manualEntry" placeholder="Type here..." style="padding: 5px; background-color: white; border: 1px solid #ccc;"></textentry>
            <div style="font-size: 12px;">Manual value: @manualValue</div>
        </div>
    </div>
</root>

@code {
    private string testValue = "Initial value";
    private string manualValue = "Manual value";
    private TextEntry? manualEntry;

    public override void Tick()
    {
        base.Tick();

        if (manualEntry != null && manualEntry.Value != manualValue)
        {
            manualValue = manualEntry.Value;
            StateHasChanged();
        }
    }
}
