<Project Sdk="Microsoft.NET.Sdk">
  
  <!-- Import global shared assets (themes, fonts, images) -->
  <Import Project="..\..\Assets.props" />
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>SimpleDesktopApp</RootNamespace>
  </PropertyGroup>

  <!-- Single-file publish configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Enable single-file publishing -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Include native libraries inside the single-file bundle -->
    <!-- PathResolver workaround in NativeWindow.cs enables finding extracted DLLs -->
    <!-- See: https://github.com/dotnet/Silk.NET/issues/2157 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Enable ReadyToRun for better startup performance -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Trim unused assemblies to reduce size -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Self-contained = false to use framework-dependent deployment (smaller) -->
    <!-- Set to true for fully self-contained deployment -->
    <SelfContained>false</SelfContained>
    <!-- When trimming is enabled, use partial mode to preserve native interop -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalazor.UI\Avalazor.UI.csproj" />
    <ProjectReference Include="..\..\src\Sandbox.UI.AI\Sandbox.UI.AI.csproj" />
    <!-- Build-time only reference - ensures Avalazor.Build is compiled before this project -->
    <!-- ReferenceOutputAssembly=false prevents the assembly from being referenced, only ensures build order -->
    <!-- File locking prevention is handled by GenerateDependencyFile=true in Avalazor.Build.csproj -->
    <ProjectReference Include="..\..\src\Avalazor.Build\Avalazor.Build.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--  Determine whether to exclude assets from single-file bundle -->
  <PropertyGroup>
    <_ExcludeAssetsFromSingleFile Condition="'$(PackAssets)' == 'true'">false</_ExcludeAssetsFromSingleFile>
    <_ExcludeAssetsFromSingleFile Condition="'$(PackAssets)' != 'true'">true</_ExcludeAssetsFromSingleFile>
  </PropertyGroup>

  <!-- Project-specific Assets folder (overrides global assets if same path) -->
  <ItemGroup>
    <!-- Copy assets to output keeping Assets\ prefix -->
    <!-- Use None instead of Content to allow ExcludeFromSingleFile to work -->
    <!-- ExcludeFromSingleFile controlled by PackAssets property (default: true = keep on disk) -->
    <None Include="Assets\**\*" Exclude="Assets\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- CopyToPublishDirectory: Only copy to publish when NOT packing (when packing, it gets embedded) -->
      <CopyToPublishDirectory Condition="'$(PackAssets)' == 'true'">Never</CopyToPublishDirectory>
      <CopyToPublishDirectory Condition="'$(PackAssets)' != 'true'">PreserveNewest</CopyToPublishDirectory>
      <!-- TargetPath ensures Assets\ prefix is preserved in both output and when extracted from single-file -->
      <TargetPath>Assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <!-- When PackAssets=false or unset (default), exclude from bundle (keep on disk) -->
      <!-- When PackAssets=true, do NOT exclude (embed in exe and extract to temp at runtime) -->
      <ExcludeFromSingleFile>$(_ExcludeAssetsFromSingleFile)</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- Import Avalazor build targets for Razor and SCSS -->
  <Import Project="..\..\src\Avalazor.Build\build\Avalazor.Build.targets" />
</Project>
