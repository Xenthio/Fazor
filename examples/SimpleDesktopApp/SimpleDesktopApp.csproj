<Project Sdk="Microsoft.NET.Sdk">
  
  <!-- Import global shared assets (themes, fonts, images) -->
  <Import Project="..\..\Assets.props" />
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>SimpleDesktopApp</RootNamespace>
  </PropertyGroup>

  <!-- Disable console window on Windows -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!-- Single-file publish configuration (disabled for Native AOT) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(PublishAot)' != 'true'">
    <!-- Enable single-file publishing (not compatible with Native AOT) -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Include native libraries inside the single-file bundle -->
    <!-- PathResolver workaround in NativeWindow.cs enables finding extracted DLLs -->
    <!-- See: https://github.com/dotnet/Silk.NET/issues/2157 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Include all content files in self-extract when PackAssets=true -->
    <IncludeAllContentForSelfExtract Condition="'$(PackAssets)' == 'true'">true</IncludeAllContentForSelfExtract>
    <!-- Disable ReadyToRun for smaller binary size -->
    <!-- R2R precompiles code for faster startup but increases size significantly -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!-- Release configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Trim unused assemblies to reduce size -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Self-contained = false to use framework-dependent deployment (smaller) -->
    <!-- Set to true for fully self-contained deployment -->
    <SelfContained>false</SelfContained>
    <!-- When trimming is enabled, use partial mode to preserve native interop -->
    <TrimMode>partial</TrimMode>
    <!-- Disable debug symbols in release builds to reduce size -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Avalazor.UI\Avalazor.UI.csproj" />
    <!-- Sandbox.UI.AI is optional - only needed for headless/AI debugging mode -->
    <!-- <ProjectReference Include="..\..\src\Sandbox.UI.AI\Sandbox.UI.AI.csproj" /> -->
    <!-- Build-time only reference - ensures Avalazor.Build is compiled before this project -->
    <!-- ReferenceOutputAssembly=false prevents the assembly from being referenced, only ensures build order -->
    <!-- File locking prevention is handled by GenerateDependencyFile=true in Avalazor.Build.csproj -->
    <ProjectReference Include="..\..\src\Avalazor.Build\Avalazor.Build.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Native AOT / Trimming configuration -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="rd.xml" />
  </ItemGroup>

  <!-- Project-specific Assets with conditional packaging -->
  <Choose>
    <When Condition="'$(PackAssets)' == 'true'">
      <!-- PackAssets=true: Copy to publish, then embed in exe -->
      <!-- Files must be in publish directory first for MSBuild to bundle them -->
      <!-- MSBuild automatically removes bundled files from publish directory -->
      <ItemGroup>
        <Content Include="Assets\**\*" Exclude="Assets\README.md">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
          <TargetPath>Assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
          <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
        </Content>
      </ItemGroup>
    </When>
    <Otherwise>
      <!-- PackAssets=false (default): Keep assets as separate files on disk -->
      <ItemGroup>
        <Content Include="Assets\**\*" Exclude="Assets\README.md">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
          <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
          <TargetPath>Assets\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
          <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        </Content>
      </ItemGroup>
    </Otherwise>
  </Choose>

  <!-- Import Avalazor build targets for Razor and SCSS -->
  <Import Project="..\..\src\Avalazor.Build\build\Avalazor.Build.targets" />
</Project>
