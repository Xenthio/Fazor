@namespace SimpleDesktopApp
@using Sandbox.UI
@using System
@attribute [StyleSheet("/XGUI/DefaultStyles/Computer11.scss")]
@inherits Window

<root title="Custom Chrome Test - Physical Padding" hasminimise="true" hasmaximise="true" hasclose="true" 
      windowwidth="600" windowheight="400">
    <div class="window-content" style="padding: 20px;">
        <h2>Custom Chrome Window with Physical Padding</h2>
        
        <section style="margin-top: 20px;">
            <h3>✨ Physical Padding Solution</h3>
            <p>This window has custom chrome (borderless with UI titlebar).</p>
            <p><strong>New approach:</strong></p>
            <ul>
                <li>✅ Native window is 8px larger on all sides</li>
                <li>✅ Content is inset by 8px, creating invisible border</li>
                <li>✅ Mouse can interact with edges even when outside visible area</li>
                <li>✅ Edge detection works at original 5px distance</li>
            </ul>
        </section>
        
        <section style="margin-top: 20px;">
            <h3>🎯 How to Test</h3>
            <p><strong>Try resizing from the edges:</strong></p>
            <ul>
                <li>Move mouse slightly outside the visible window edge</li>
                <li>You should still be able to grab and resize</li>
                <li>The invisible 8px padding captures mouse events</li>
            </ul>
        </section>
        
        <section style="margin-top: 20px;">
            <h3>⚡ Performance Improvements</h3>
            <ul>
                <li>✅ Drag only updates when actively dragging</li>
                <li>✅ Position changes cached to reduce API calls</li>
                <li>✅ No redundant updates when position unchanged</li>
            </ul>
        </section>
        
        <section style="margin-top: 20px;">
            <p style="color: #888;">Drag State: @(IsDragging ? "DRAGGING" : "Idle")</p>
            <p style="color: #888;">Resize State: @(IsResizing ? "RESIZING" : "Idle")</p>
        </section>
    </div>
</root>

@code {
    protected override void OnAfterTreeRender(bool firstTime)
    {
        base.OnAfterTreeRender(firstTime);
        
        if (firstTime)
        {
            Console.WriteLine("CustomChromeTest initialized with physical padding");
            Console.WriteLine($"HasCustomChrome: {HasCustomChrome}");
            Console.WriteLine($"Window has 8px invisible padding around edges for resize detection");
        }
    }
}
