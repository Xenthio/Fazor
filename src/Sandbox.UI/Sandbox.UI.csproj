<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>BL0006;CS0649;CS0414;CS1591</NoWarn>
    <RootNamespace>Sandbox.UI</RootNamespace>
    <AssemblyName>Sandbox.UI</AssemblyName>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Fazor.Sandbox.UI</PackageId>
    <Version>0.1.0</Version>
    <Authors>Xenthio</Authors>
    <Company>Xenthio</Company>
    <Description>Core UI framework for Fazor - renderer-agnostic port of s&amp;box's UI framework. Contains Panel system, styling engine, layout (Yoga), and controls.</Description>
    <PackageProjectUrl>https://github.com/Xenthio/Fazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xenthio/Fazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;razor;desktop;ui;sandbox;panel;styling</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sandbox.UI.Skia" />
    <InternalsVisibleTo Include="Fazor.UI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Razor/Blazor support for RenderTreeBuilder extensions -->
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
  </ItemGroup>

  <!-- Copy native Yoga library to output directory -->
  <ItemGroup>
    <None Include="..\Fazor.UI\Native\libyoga.so" Condition="Exists('..\Fazor.UI\Native\libyoga.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libyoga.so</Link>
    </None>
    <None Include="..\Fazor.UI\Native\libyoga.dylib" Condition="Exists('..\Fazor.UI\Native\libyoga.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libyoga.dylib</Link>
    </None>
    <None Include="..\Fazor.UI\Native\yoga.dll" Condition="Exists('..\Fazor.UI\Native\yoga.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>yoga.dll</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Microsoft.AspNetCore.Components\Microsoft.AspNetCore.Components.csproj" />
  </ItemGroup>

</Project>
