<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>AI-focused rendering backend for Sandbox.UI that outputs structured text and optional bitmap representations for AI agent debugging and interaction</Description>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Fazor.Sandbox.UI.AI</PackageId>
    <Version>0.1.0</Version>
    <Authors>Xenthio</Authors>
    <Company>Xenthio</Company>
    <PackageProjectUrl>https://github.com/Xenthio/Fazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xenthio/Fazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;razor;desktop;ui;ai;debugging;headless</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sandbox.UI\Sandbox.UI.csproj" />
    <ProjectReference Include="..\Fazor.Controls\Fazor.Controls.csproj" />
    <ProjectReference Include="..\Sandbox.UI.Skia\Sandbox.UI.Skia.csproj" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

</Project>
