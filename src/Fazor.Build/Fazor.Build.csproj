<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <DevelopmentDependency>true</DevelopmentDependency>
    <!-- Prevent output assembly from being locked by MSBuild -->
    <GenerateDependencyFile>true</GenerateDependencyFile>

    <!-- NuGet Package Metadata -->
    <PackageId>Fazor.Build</PackageId>
    <Version>0.1.0</Version>
    <Authors>Xenthio</Authors>
    <Company>Xenthio</Company>
    <Description>MSBuild integration for Fazor. Provides automatic Razor transpilation and SCSS compilation at build time. Required for Fazor projects.</Description>
    <PackageProjectUrl>https://github.com/Xenthio/Fazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Xenthio/Fazor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>blazor;razor;msbuild;build;scss;compiler</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Use PrivateAssets="all" to prevent transitive dependencies and enable isolated assembly loading (via .deps.json generation) which prevents assembly locking issues -->
    <ProjectReference Include="..\Sandbox.Razor\Sandbox.Razor.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\**\*" Pack="true" PackagePath="build\" />
  </ItemGroup>
</Project>
