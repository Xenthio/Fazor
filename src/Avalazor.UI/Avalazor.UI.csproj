<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- <TargetFramework>net10.0-windows</TargetFramework> -->
		<TargetFramework>net10.0</TargetFramework>
		<!-- Use -windows to ensure Skia/D3D compat -->
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>BL0006;CS0649;CS0414</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
		<DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- Core windowing and input dependencies (ALL VERSIONS MUST MATCH 2.22.0) -->
		<PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" />
		<PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
		<PackageReference Include="Silk.NET.Input.Sdl" Version="2.22.0" />
		<PackageReference Include="Silk.NET.Input" Version="2.22.0" />
		
		<!-- Graphics backends -->
		<!-- OpenGL backend (used on Linux/macOS, fallback on Windows) -->
		<PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
		<!-- Direct3D11 backend (required for Windows - OpenGL is broken on Windows) -->
		<PackageReference Include="Silk.NET.Direct3D11" Version="2.22.0" />
		<PackageReference Include="Silk.NET.DXGI" Version="2.22.0" />
		<!-- Vulkan backend (optional - only include when explicitly needed) -->
		<PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" Condition="$(DefineConstants.Contains('INCLUDE_VULKAN_BACKEND'))" />
		<PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.22.0" Condition="$(DefineConstants.Contains('INCLUDE_VULKAN_BACKEND'))" />

		<!-- Skia -->
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
		<PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.1" />
		<PackageReference Include="HarfBuzzSharp" Version="8.3.1.2" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.2" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.2" />
		<PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.2" />

		<!-- Utilities -->
		<PackageReference Include="ExCSS" Version="4.2.3" />
		<PackageReference Include="AngleSharp" Version="1.1.2" />

		<!-- Blazor -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Sandbox.UI\Sandbox.UI.csproj" />
		<ProjectReference Include="..\Sandbox.UI.Skia\Sandbox.UI.Skia.csproj" />
		<!-- AI renderer is optional - only include if INCLUDE_AI_RENDERER is defined -->
		<ProjectReference Include="..\Sandbox.UI.AI\Sandbox.UI.AI.csproj" Condition="$(DefineConstants.Contains('INCLUDE_AI_RENDERER'))" />
		<ProjectReference Include="..\Microsoft.AspNetCore.Components\Microsoft.AspNetCore.Components.csproj" />
	</ItemGroup>

	<!-- Include Yoga native libraries for all platforms -->
	<ItemGroup>
		<None Include="Native/yoga.dll" CopyToOutputDirectory="PreserveNewest" Link="yoga.dll" CopyToPublishDirectory="PreserveNewest" />
		<None Include="Native/libyoga.so" CopyToOutputDirectory="PreserveNewest" Link="libyoga.so" CopyToPublishDirectory="PreserveNewest" />
		<None Include="Native/libyoga.dylib" CopyToOutputDirectory="PreserveNewest" Link="libyoga.dylib" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>